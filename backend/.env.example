# VirtualExamp Backend Environment
# Copy this file to .env and update values

# Application
APP_NAME=VirtualExamp API
APP_VERSION=1.0.0
DEBUG=true

# Server
HOST=0.0.0.0
PORT=8000

# Database (PostgreSQL)
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/virtualexamp

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT Authentication
# IMPORTANT: Change this in production!
SECRET_KEY=your-super-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# File Upload
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=50

# Rate Limiting
RATE_LIMIT_UPLOADS_PER_HOUR=5
RATE_LIMIT_EXAMS_PER_DAY=10

# CORS
CORS_ORIGINS=["http://localhost:3000"]
