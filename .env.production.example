# VirtualExamp Production Environment (CasaOS)
# Copy to .env.production and update values

# Server IP - IP address CasaOS kamu (yang bisa diakses dari browser)
SERVER_IP=192.168.31.48

# Database
POSTGRES_PASSWORD=ganti_dengan_password_kuat

# JWT Secret - generate dengan: openssl rand -hex 32
SECRET_KEY=ganti_dengan_secret_key_random
